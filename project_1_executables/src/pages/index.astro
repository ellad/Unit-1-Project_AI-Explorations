    }

    function routerValues() {
      const kwh = state.routerWatts * 24 / 1000;
      return { kwh, carbon: kwh * getLoc().grid, water: kwh * NREL_L_PER_KWH };
    }
    function routerComparisonRow(scale = 1) {
      return { label: 'Router (' + state.routerWatts + ' W, 24 h/day)',
        v: routerValues()[state.metric] * scale, router: true };
    }

    // A whole-project comparison: never multiply by days or pie selection.
    function projectComparisonRows() {
      if (!state.codingSessions.some((session) => session.lines > 0)) return [];
      return [{ label: 'Coding — whole project (all sessions)',
        v: codingProjectTotals()[state.metric], project: true }];
    }

    function itemBase(item, metric) { return metric === 'carbon' ? item.c * 1000 : item.w * GAL_TO_L; }

    // ---- Coding-project sessions (Feature 3) ----
    // Unlike every other entry, a coding session is not a daily quantity: it is
    // one discrete project session. Sessions sum into a separate project total
    // that never joins the daily/annual AI-use totals above (plan.md's explicit
    // rule, so a project's one-time cost is never mistaken for a recurring one).
    const REF_TOKENS = 100000;      // EcoLogits' own coding/agent benchmark, in tokens
    const REF_LINES_STANDARD = 1500; // that same benchmark, in lines (100000*0.15/10)
    const REF_LINES_HEAVY = 8880;    // Couch's ~592,000-token self-logged session (n=1); shown as ~8,900
    const MAX_SESSION_LINES = 100000; // input-sanity ceiling only, not a research bound
    function tokensForLines(lines) { return (lines * TOKENS_PER_LINE) / CODE_FRACTION; }
