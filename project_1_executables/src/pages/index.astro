    function setDefaultRows() { state.rows = DEFAULT_ROWS.map((r) => ({ uid: uidSeq++, model: r[0], size: r[1], count: r[2], retry: 1 })); }

    // ---- Usage rows ----
    // onChange lets coding sessions (a separate array from state.rows) reuse
