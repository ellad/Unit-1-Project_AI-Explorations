        [state.videos.reduce((n, e) => n + (e.duration > 0 ? e.count : 0), 0), 'video clip']];
      return categories.filter(([n]) => n > 0).map(([n, label]) => n.toLocaleString('en-US') + ' ' + label + (n === 1 ? '' : 's')).join(' and ');
    }

    function activityValues(id) {
      const activity = ACTIVITIES.find((a) => a.id === id);
      const hours = state.activities[id];
      const kwh = activity.kwh.map((factor) => hours * factor);
      const carbon = activity.carbonPerHour === undefined
        ? kwh.map((value) => value * getLoc().grid)
