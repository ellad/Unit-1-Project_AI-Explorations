    const aiDaily = (metric) => aiDailyTriple(metric)[0];
    function aiDailyEnergy() { let t = 0; for (const r of state.rows) if (r.count) t += r.count * (r.retry || 1) * getModel(r.model).sizes[r.size].wh; for (const e of state.images) t += imageEntryValues(e).wh; for (const e of state.videos) t += videoEntryValues(e).wh; return t; }
    // Media calculations use Wh, grams of CO2e, and liters. The video's
