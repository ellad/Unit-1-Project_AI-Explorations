        images: state.images.map(({ count, retry }) => ({ count, retry })),
        videos: state.videos.map(({ count, retry, duration }) => ({ count, retry, duration })),
        codingSessions: state.codingSessions.map(({ model, lines, includeInPie }) => ({ model, lines, includeInPie: Boolean(includeInPie) })),
