    // representing a re-run as another distinct session (its own line count)
    // is more honest than multiplying this one's footprint by a flat factor.
    function codingSessionValues(session) {
      const basis = codingBasis(getModel(session.model));
      const tokens = tokensForLines(session.lines || 0);
