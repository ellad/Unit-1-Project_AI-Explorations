    }
    function activitySummary(values, scale, carbonLabel = 'carbon') {
      return formatPair(values.kwh, (kwh) => fmtEnergy(kwh * 1000), scale) + '; ' +
        formatPair(values.carbon, fmtCarbon, scale) + ' ' + carbonLabel + '; ' +
        formatPair(values.water, fmtWater, scale) + ' derived water.';
    }
    function digitalComparisonRows(scale = 1) {
      return ACTIVITIES.map((activity) => {
        const pair = activityValues(activity.id)[state.metric].map((value) => value * scale);
