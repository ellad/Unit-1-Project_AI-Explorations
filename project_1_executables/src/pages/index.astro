    const VIDEO_PUE = 1.09, VIDEO_REF_SECONDS = 8;

    // Electricity factors are kWh per hour. Gaming retains both endpoints;
    // no invented midpoint enters either its display or the activity total.
    const ACTIVITIES = [
      { id: 'streaming', label: 'Streaming', kwh: [0.077, 0.077], carbonPerHour: 36,
        note: '<a href="https://www.iea.org/commentaries/the-carbon-footprint-of-streaming-video-fact-checking-the-headlines" target="_blank" rel="noopener">IEA (2020)</a>: 0.077 kWh and 36 g carbon per hour, using a 2019 global baseline. This dated estimate does not describe every device or today’s higher-resolution streaming. Carbon stays at the published global value when you change location.' },
      { id: 'videoCall', label: 'Video calls', kwh: [0.049, 0.049],
        note: '<a href="https://davidmytton.blog/zoom-video-conferencing-energy-and-emissions/" target="_blank" rel="noopener">David Mytton</a>: 0.049 kWh per hour, rounded from 0.0486 kWh for the network traffic of both participants in a one-to-one 1080p call, not one participant alone. This bandwidth-based estimate excludes device and data-center energy, so it likely undercounts. Group calls and camera settings differ; the author’s 2023 update cautions against using this method for present-day assessments. Carbon is our calculation from energy and your selected grid.' },
      { id: 'gaming', label: 'Gaming', kwh: [0.160, 0.305],
        note: '<a href="https://arxiv.org/abs/2608.19040" target="_blank" rel="noopener">Hot Games</a>: our assumed 160–305 W console-to-desktop-PC range; the paper reports a weighted PC figure of 305.1 W, while 160 W is our retained console scenario. This is a hardware range, not a statistical confidence interval; mobile gaming is excluded. Carbon is our calculation from energy and your selected grid.' },
      { id: 'social', label: 'Social media', kwh: [15.81 * 60 * 3.7 / 1e6, 15.81 * 60 * 3.7 / 1e6],
        note: 'Greenspector’s 2021 study reported TikTok battery draw of 15.81 mAh per minute on one Galaxy S7. Our assumed 3.7 V converts that to 3.50982 Wh per hour. Source note: the original Greenspector page is unavailable. The <a href="https://sas-dhrh.github.io/dhcc-toolkit/toolkit/working-practices.html" target="_blank" rel="noopener">Digital Humanities Climate Coalition toolkit</a> reproduces the 15.81 figure with an explicit one-minute unit, and <a href="https://cwrrr.org/resources/analysis-reviews/tis-the-season-to-be-worried-our-online-habits/" target="_blank" rel="noopener">CWR</a> also reproduces the figure. These corroborate the reported value; they are reproductions of the same study, not independent measurements. This phone-battery proxy excludes network, data-center, and charging losses; it is not a social-media-wide average. Carbon and water are our derivations.' },
