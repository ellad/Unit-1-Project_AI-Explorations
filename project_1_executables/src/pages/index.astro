    const codingSessionColors = new Map();
    function codingSessionColor(uid) {
      // Stable by session ID: removing a session does not recolor the others.
      // Spread hues through red, orange, and yellow without cycling a short palette.
      if (codingSessionColors.has(uid)) return codingSessionColors.get(uid);
      const index = codingSessionColors.size;
      const hue = index === 0 ? 54 : (54 + index * 37.082039325) % 65;
      const color = 'hsl(' + hue.toFixed(6) + ' 100% 50%)';
      codingSessionColors.set(uid, color);
      return color;
    }

    // Color fallbacks keep the full gradient valid during stylesheet hot reloads.
    // Pie scenarios preserve source endpoints; gaming has no published mean.
    function pieContributions() {
      const metric = state.metric, high = state.pieBound === 'high';
      const rows = [];
      const add = (id, label, low, upper, color) => {
        const value = high ? upper : low;
        if (value > 0) rows.push({ id, label, low, high: upper, value, color });
      };
      let textLow = 0, textHigh = 0;
      for (const row of state.rows) {
        const t = perPromptTriple(getModel(row.model), row.size, metric);
        textLow += row.count * (row.retry || 1) * t[1];
        textHigh += row.count * (row.retry || 1) * t[2];
      }
      add('text', 'Chatbot & text', textLow, textHigh, 'var(--pie-green, #6fbf94)');
      const images = imageDailyTriple(metric), videos = videoDailyTriple(metric);
      add('images', 'Image generation', images[1], images[2], 'var(--pie-blue, #74b3e0)');
      add('videos', 'Video generation', videos[1], videos[2], 'var(--pie-gold, #c4aa6e)');
      const colors = ['var(--pie-purple, #b095ce)', 'var(--pie-call-blue, #3658ab)', 'var(--pie-rose, #da8da9)', 'var(--pie-orange, #dfa06e)'];
      ACTIVITIES.forEach((activity, i) => {
        const pair = activityValues(activity.id)[metric];
        add(activity.id, activity.label, pair[0], pair[1], colors[i]);
      });
      const router = routerValues()[metric];
      add('router', 'Router — 24 hours', router, router, 'var(--pie-router, #287044)');
      state.codingSessions.forEach((session, i) => {
        if (!session.includeInPie) return;
        const value = codingSessionValues(session)[metric];
        add('session-' + session.uid, 'Coding session ' + (i + 1) + ' — ' + getModel(session.model).name + ' (once)', value, value, codingSessionColor(session.uid));
      });
      return rows;
    }
    function renderPie() {
      const rows = pieContributions().sort((a, b) => b.value - a.value), total = rows.reduce((sum, row) => sum + row.value, 0);
      const scenario = state.pieBound === 'high' ? 'Upper' : 'Lower';
      root.querySelector('#aipf-pie-metric').value = state.metric;
      root.querySelector('#aipf-pie-bound').value = state.pieBound;
      root.querySelector('#aipf-pie-total').textContent = total > 0
        ? scenario + '-estimate total for this day: ' + fmtMetric(total) + '.'
        : 'No footprint to show. Add usage, enter activity hours, set router watts, or select a coding session.';
      root.querySelector('#aipf-pie-caption').textContent = 'One-day ' + metricWord() + ' breakdown — ' + scenario.toLowerCase() + ' estimate';
      const disc = root.querySelector('#aipf-pie-disc');
      disc.hidden = total <= 0;
      const body = root.querySelector('#aipf-pie-values'); body.innerHTML = '';
      let end = 0;
      const stops = [];
      for (const row of rows) {
        const start = end; end += row.value / total * 100;
        stops.push(row.color + ' ' + start + '% ' + end + '%');
        const tr = document.createElement('tr');
        const label = document.createElement('th'); label.scope = 'row';
        const swatch = el('span', 'aipf-pie-swatch'); swatch.style.background = row.color; swatch.setAttribute('aria-hidden', 'true');
        label.appendChild(swatch); label.appendChild(document.createTextNode(row.label));
        tr.appendChild(label);
        const value = el('td', '', fmtMetric(row.value));
        if (row.low !== row.high) value.appendChild(el('small', '', 'Range: ' + fmtMetric(row.low) + '–' + fmtMetric(row.high)));
        tr.appendChild(value);
        const percent = row.value / total * 100;
        tr.appendChild(el('td', '', percent < 0.1 ? '<0.1%' : percent.toFixed(1) + '%'));
        body.appendChild(tr);
      }
      disc.style.background = total > 0 ? 'conic-gradient(' + stops.join(', ') + ')' : '';
      if (!rows.length) {
        const tr = document.createElement('tr'), td = el('td', '', 'No non-zero contributions.');
        td.colSpan = 3; tr.appendChild(td); body.appendChild(tr);
      }
    }

    function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
    function renderBars(targetId, focalLabel, focalVal, items, unit, extraRows = []) {
      const rows = [{ label: focalLabel, v: focalVal, focal: true }];
      for (const it of items) {
        const v = itemBase(it, state.metric);
        if (v <= 0) continue; // skip items with no impact in this metric (keeps the water view clean)
        rows.push({ label: it.label, v: v, dir: it.dir });
      }
      rows.push(...extraRows);
      rows.sort((a, b) => b.v - a.v);
      const max = Math.max.apply(null, rows.map((r) => r.v).concat([1e-9]));
      const box = root.querySelector(targetId);
      box.innerHTML = '';
      for (const r of rows) {
        const row = el('div', 'aipf-bar-row' + (r.focal ? ' is-focal' : '') + (r.digital ? ' is-digital' : '') + (r.router ? ' is-router' : '') + (r.project ? ' is-project' : ''));
        let labelHtml = esc(r.label);
        if (r.project) labelHtml += ' <span class="aipf-tag">whole project</span>';
        if (r.router) labelHtml += ' <span class="aipf-tag">infrastructure</span>';
        if (r.digital) labelHtml += ' <span class="aipf-tag">digital life</span>';
        if (r.dir === 'save') labelHtml += ' <span class="aipf-tag aipf-tag--save">saved</span>';
        else if (r.dir === 'add') labelHtml += ' <span class="aipf-tag aipf-tag--add">added</span>';
        row.appendChild(el('div', 'aipf-bar-label', labelHtml));
        const track = el('div', 'aipf-bar-track');
        const fill = el('div', 'aipf-bar-fill');
        const solidValue = r.low === undefined ? r.v : r.low;
        fill.style.width = (solidValue <= 0 ? 0 : Math.max(0.4, (solidValue / max) * 100)).toFixed(2) + '%';
        track.appendChild(fill);
        if (r.high > r.low) {
          const range = el('div', 'aipf-bar-range');
          range.style.left = (r.low / max * 100).toFixed(2) + '%';
          range.style.width = ((r.high - r.low) / max * 100).toFixed(2) + '%';
          track.appendChild(range);
        }
        track.setAttribute('aria-hidden', 'true');
        row.appendChild(track);
        const value = r.high > r.low ? fmtUnit(r.low, unit) + '–' + fmtUnit(r.high, unit) : fmtUnit(r.v, unit);
        row.appendChild(el('div', 'aipf-bar-val', value));
        box.appendChild(row);
      }
    }
    function renderDaily() {
