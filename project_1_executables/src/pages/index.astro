      images: [],
      videos: [],
      codingSessions: [],
      activities: { streaming: 0, videoCall: 0, gaming: 0, social: 0 },
      routerWatts: DEFAULT_ROUTER_WATTS,
      pieBound: 'low',
      metric: 'carbon', loc: 'us', headcount: 300,
